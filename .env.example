# Jaytees Attendance App — Free-Tier Cloud Configuration
# The app runs immediately out-of-the-box with built-in local storage persistence for demo/testing.
# When deploying to Vercel with a free Supabase project, copy this to .env.local and fill in:

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
